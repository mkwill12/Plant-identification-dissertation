ning Data...\")\n","train_ds = tf.keras.utils.image_dataset_from_directory(\n","    os.path.join(data_dir, 'train'),\n","    seed=123,\n","    image_size=img_size,\n","    batch_size=batch_size\n",")\n","\n","print(\"Loading Validation Data...\")\n","#check for valid and test and use one for validation\n","val_dir = os.path.join(data_dir, 'valid')\n","if not os.path.exists(val_dir):\n","    val_dir = os.path.join(data_dir, 'test')\n","\n","val_ds = tf.keras.utils.image_dataset_from_directory(\n","    val_dir,\n","    seed=123,\n","    image_size=img_size,\n","    batch_size=batch_size\n",")\n","\n","#On the fly data augmentation\n","data_augmentation = tf.keras.Sequential([\n","    # Replaced Resize and Crop with RandomZoom to prevent shape mismatch\n","    layers.RandomZoom(0.2),\n","    layers.RandomFlip(\"horizontal\"),\n","    layers.RandomBrightness(factor=0.2),\n","    layers.RandomContrast(factor=0.2),\n","    layers.RandomRotation(factor=10.0 / 360.0)\n","])\n","\n","#Model building MobileNetV2\n","base_model = tf.keras.applications.MobileNetV2(\n","    input_shape=(224, 224, 3),\n","    include_top=False,\n","    weights='imagenet'\n",")\n","base_model.trainable = False\n","\n","model = models.Sequential([\n","    data_augmentation,\n","    layers.Rescaling(1./127.5, offset=-1),\n","    base_model,\n","    layers.GlobalAveragePooling2D(),\n","    layers.Dropout(0.2),\n","    layers.Dense(len(train_ds.class_names), activation='softmax')\n","])\n","\n","model.compile(optimizer='adam',\n","              loss='sparse_categorical_crossentropy',\n","              metrics=['accuracy'])\n","\n","#Training\n","print(\"Starting Training...\")\n","history = model.fit(\n","    train_ds,\n","    validation_data=val_ds,\n","    epochs=15\n",")\n","\n","#Saving model (Using the modern .keras format to fix the pickle error)\n","model.save('MobileNetV2Model.keras')\n","print(\"Model saved as 'MobileNetV2Model.keras'\")\n","\n","# Converting to tflite\n","saved_model = tf.keras.models.load_model('MobileNetV2Model.keras')\n","converter = tf.lite.TFLiteConverter.from_keras_model(saved_model)\n","\n","# Disable optimizations so the Pi can understand the standard math!\n","\n","tflite_model = converter.convert()\n","\n","with open('MobileNetV2Model_uncompressed.tflite', 'wb') as f:\n","    f.write(tflite_model)\n","\n","print(\"Success! Uncompressed model created.\")\n","from google.colab import files\n","files.download('MobileNetV2Model_uncompressed.tflite')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"CRJQXE0PxjHk","executionInfo":{"status":"ok","timestamp":1775245312506,"user_tz":-60,"elapsed":70304,"user":{"displayName":"Marley","userId":"00315820676442879004"}},"outputId":"983cc136-a107-4293-c2e7-f63d87c199cd"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Unzipping dataset... (this might take a minute)\n","Unzip Complete!\n","Training data found at: /content/dataset_unzipped\n","Loading Training Data...\n","Found 714 files belonging to 7 classes.\n","Loading Validation Data...\n","Found 68 files belonging to 7 classes.\n","Downloading data from https://storage.googleapis.com/tensorflow/keras-applications/mobilenet_v2/mobilenet_v2_weights_tf_dim_ordering_tf_kernels_1.0_224_no_top.h5\n","\u001b[1m9406464/9406464\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 0us/step\n","Starting Training...\n","Epoch 1/15\n","\u001b[1m23/23\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m14s\u001b[0m 150ms/step - accuracy: 0.4566 - loss: 1.5005 - val_accuracy: 0.7059 - val_loss: 0.9564\n","Epoch 2/15\n","\u001b[1m23/23\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 65ms/step - accuracy: 0.7801 - loss: 0.7195 - val_accuracy: 0.8676 - val_loss: 0.5709\n","Epoch 3/15\n","\u001b[1m23/23\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 6